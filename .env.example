# Copy to .env and adjust per deployment. .env is git-ignored.

# Bake the local AI-detection model into the image (no runtime internet needed).
# false = small heuristic-only image; true = full model image.
WITH_MODEL=false

# Which HuggingFace text-classification model to use as the local detector.
AI_DETECTOR_MODEL=roberta-base-openai-detector
