# Copy to .env and adjust per deployment. .env is git-ignored.

# Bake the local models into the image (no runtime internet needed).
# false = small heuristic-only image; true = full model image.
WITH_MODEL=false

# Local AI-generated-text detector (HuggingFace text-classification model).
# Default below is GPT-2-era and weak on modern LLMs — swap for a MAGE/DeTeCtive
# style multi-LLM detector for real accuracy.
AI_DETECTOR_MODEL=roberta-base-openai-detector

# Local phishing classifier (HuggingFace text-classification model).
# Leave empty to use rule-based heuristics only.
# Recommended: ealvaradob/bert-finetuned-phishing
PHISHING_MODEL=
